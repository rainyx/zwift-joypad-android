    <!-- 关于 -->
    <string name="version_fmt">Version %1$s</string>
    <string name="author">Author</string>
    <string name="features">Features</string>
    <string name="disclaimer">Disclaimer</string>
    <string-array name="feature_list">
        <item>Turns your phone into a Zwift controller that connects to Zwift over Bluetooth, with no extra hardware or PC software</item>
        <item>Full button set: D-pad, Y / Z / A / B, −/＋ shifting, ZL / ZR paddles for steering and braking, multi-touch</item>
        <item>Receives in-game events from Zwift (collisions, Ride On, power-ups…), shows them at the top and vibrates</item>
        <item>Two button styles (Realistic / Simple) and three backgrounds (Zwift orange / dark / light)</item>
        <item>Press and hold an empty area to see the Zwift action of each button</item>
        <item>Custom key code for every button; channel, invert and range for each paddle</item>
        <item>Protocol log for troubleshooting connections</item>
    </string-array>
    <string-array name="disclaimer_list">
        <item>This software is for learning and technical research only. Do not use it for any commercial purpose.</item>
        <item>This is a personal open-source project. It is not affiliated with, authorized or endorsed by Zwift, Inc. Zwift and related product names and trademarks belong to their respective owners.</item>
        <item>You use this software at your own risk. The author is not responsible for any consequences, including but not limited to problems with accounts, devices or data.</item>
        <item>This software is provided \"as is\", without warranty of any kind, express or implied.</item>
    </string-array>

