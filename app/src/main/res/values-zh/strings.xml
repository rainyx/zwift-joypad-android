    <!-- 关于 -->
    <string name="version_fmt">版本 %1$s</string>
    <string name="author">作者</string>
    <string name="features">功能介绍</string>
    <string name="disclaimer">免责声明</string>
    <string-array name="feature_list">
        <item>把手机模拟成 Zwift 手柄，通过蓝牙直接连接 Zwift，无需额外硬件或电脑端软件</item>
        <item>完整按键：方向键、Y / Z / A / B、−/＋ 换挡，ZL / ZR 拨片转向与刹车，支持多点触控</item>
        <item>接收 Zwift 下发的游戏事件（碰撞、RideOn、道具…），顶部提示并震动</item>
        <item>仿真 / 简约两种按键外观，Zwift 橙 / 深色 / 浅色三种背景</item>
        <item>长按空白处查看每个按键对应的 Zwift 动作</item>
        <item>每个按键可自定义键码，拨片可选通道、反向和满量程</item>
        <item>协议日志，方便排查连接问题</item>
    </string-array>
    <string-array name="disclaimer_list">
        <item>本软件仅供学习与技术研究使用，切勿用于任何商业用途。</item>
        <item>本软件是个人开源项目，与 Zwift, Inc. 无任何关联，也未获其授权或认可；Zwift 及相关产品名称、商标归其各自所有者。</item>
        <item>使用本软件产生的任何后果（包括但不限于账号、设备、数据方面的问题）由使用者自行承担，作者不承担任何责任。</item>
        <item>本软件按“原样”提供，不附带任何明示或暗示的担保。</item>
    </string-array>

